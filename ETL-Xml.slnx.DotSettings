<wpf:ResourceDictionary xml:space="preserve" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:s="clr-namespace:System;assembly=mscorlib" xmlns:ss="urn:shemas-jetbrains-com:settings-storage-xaml" xmlns:wpf="http://schemas.microsoft.com/winfx/2006/xaml/presentation">

	<!--
	  ReSharper InspectCode noise-floor profile for ETL-Xml.

	  Goal: 0 noise findings on a clean main, so the first finding after the
	  inspectcode job lands is always actionable.

	  Scoped deliberately narrow — only rules that InspectCode cannot evaluate
	  correctly are listed here, not rules whose findings are merely
	  inconvenient. Matches ETL-Json / ETL-Abstractions / Extensions-Logging-Data.
	-->

	<!-- PublicApiAnalyzers (RS0016 "not part of the declared public API",
	     RS0036 / RS0037 nullability annotations).

	     InspectCode runs its own copy of these analyzers and does not load the
	     PublicAPI.Shipped.txt / PublicAPI.Unshipped.txt AdditionalFiles, so it
	     reports members that ARE tracked as untracked, and on projects that
	     never opted in (tests, benchmarks, examples, samples) it reports every
	     public member. The in-build analyzer
	     (Microsoft.CodeAnalysis.PublicApiAnalyzers) evaluates the baseline
	     correctly and emits none of these — a Release build runs with
	     TreatWarningsAsErrors, so RS0016 is genuinely enforced on src.

	     Confirmed empirically on ETL-Json 2026-08-19 (PR #286 → reverted by
	     #287): adding the specific members InspectCode named to
	     PublicAPI.Shipped.txt did not clear the alerts — it moved them onto
	     the next synthesized record members (PrintMembers, operator ==). The
	     set of compiler-synthesized record members is reported one at a time,
	     so chasing them is unbounded work that also pollutes the baseline
	     with entries the real analyzer does not want.

	     The build remains the authority. -->
	<s:String x:Key="/Default/CodeInspection/Highlighting/InspectionSeverities/=RS0016/@EntryIndexedValue">DO_NOT_SHOW</s:String>
	<s:String x:Key="/Default/CodeInspection/Highlighting/InspectionSeverities/=RS0036/@EntryIndexedValue">DO_NOT_SHOW</s:String>
	<s:String x:Key="/Default/CodeInspection/Highlighting/InspectionSeverities/=RS0037/@EntryIndexedValue">DO_NOT_SHOW</s:String>

	<!-- UnusedAutoPropertyAccessor.Global.

	     False positive on POCO test/benchmark/example/sample record classes
	     whose properties are populated by the test/benchmark framework and
	     consumed only through XML (de)serialization or reflection. The
	     analyzer sees no direct reader in the source and reports every getter
	     as unused, but removing them would break the round-trip these types
	     exist to exercise. Also fires on TFM polyfill attribute classes
	     (Properties/RequiresUnreferencedCodeAttribute) whose .Message getter
	     is consumed by the framework, not by our code. -->
	<s:String x:Key="/Default/CodeInspection/Highlighting/InspectionSeverities/=UnusedAutoPropertyAccessor_002EGlobal/@EntryIndexedValue">DO_NOT_SHOW</s:String>

</wpf:ResourceDictionary>
