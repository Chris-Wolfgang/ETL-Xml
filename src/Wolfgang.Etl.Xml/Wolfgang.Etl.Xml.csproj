<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net462;net481;netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>0.8.0</Version>
    <!-- ABI / binary-compatibility gate (#128). Every pack validates the built
         package against the last published version on NuGet, catching behavioural
         breaks PublicAPI.Shipped.txt diffs miss (default-value changes, nullability
         flips, binary-layout shifts). When an intentional break needs to ship,
         waive it by generating a CompatibilitySuppressions.xml
         (`dotnet pack /p:GenerateCompatibilitySuppressionFile=true`) and checking
         it in — there is none yet, so none is required today. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.8.0</PackageValidationBaselineVersion>
    <!-- Pin AssemblyVersion to a fixed binding-stability baseline so consumers
         do not need to recompile / add binding redirects on every minor/patch
         bump. Bump only on a deliberate breaking API change. FileVersion +
         InformationalVersion (the latter auto-derived from <Version>) carry
         the actual release version. -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>$([System.Text.RegularExpressions.Regex]::Replace("$(Version)", "[-+].*$", "")).0</FileVersion>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <Title>Wolfgang.Etl.Xml</Title>
    <Description>Extractor and Loader implementations for reading and writing XML and multi-stream XML files, built on Wolfgang.Etl.Abstractions.</Description>
    <PackageProjectUrl>https://github.com/Chris-Wolfgang/ETL-Xml</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Chris-Wolfgang/ETL-Xml</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <SignAssembly>False</SignAssembly>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <PackageTags>ETL;Extract-Transform-Load;XML</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <ApplicationIcon>..\..\assets\xml_icon.ico</ApplicationIcon>
    <PackageIcon>xml_icon_256.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\assets\xml_icon_256.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Wolfgang.Etl.Abstractions" Version="0.22.0" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <!-- System.Diagnostics.Metrics (Meter, #12) is in-box on net8.0+; the .NET Framework and
       netstandard2.0 TFMs need the DiagnosticSource package for it. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net462' OR '$(TargetFramework)' == 'net481' OR '$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="10.0.11" />
  </ItemGroup>

  <!-- Analyzer PackageReferences are centralized in Directory.Build.props -->


</Project>
