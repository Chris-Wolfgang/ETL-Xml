<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net462;net47;net471;net472;net48;net481;netcoreapp3.1;net5.0;net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Wolfgang.Etl.Xml\Wolfgang.Etl.Xml.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" Condition="!$(TargetFramework.StartsWith('net5.')) AND !$(TargetFramework.StartsWith('net6.')) AND !$(TargetFramework.StartsWith('net7.')) AND !$(TargetFramework.StartsWith('netcoreapp'))" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" Condition="$(TargetFramework.StartsWith('net5.')) OR $(TargetFramework.StartsWith('net6.')) OR $(TargetFramework.StartsWith('net7.')) OR $(TargetFramework.StartsWith('netcoreapp'))" />
    <PackageReference Include="System.Linq.Async" Version="7.0.1" />
    <PackageReference Include="Wolfgang.Etl.ErrorPolicies" Version="0.26.1" />
    <PackageReference Include="Wolfgang.Etl.TestKit" Version="0.26.1" />
    <PackageReference Include="Wolfgang.Etl.TestKit.Xunit" Version="0.26.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <!--
      xunit.runner.visualstudio is split by target-framework slot:
      - net8.0+ (modern slot): 3.0.1, uncapped. Runner 3.x runs xunit v2 tests and supports these TFMs.
      - net462-net481, net6.0, net7.0: 2.8.2, capped below 3.0.0 because runner 3.x drops them.
      - netcoreapp3.1 and net5.0: 2.4.5. 2.8.2 ships build/lib assets for net462 and net6.0 ONLY, so
        these two slots would resolve no test adapter and report "No test is available"; 2.4.5 is
        the newest 2.x that still ships a netcoreapp3.1 asset, which net5.0 also consumes.
    -->
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5" NoWarn="NU1701"
                      Condition="'$(TargetFramework)' == 'netcoreapp3.1' Or '$(TargetFramework)' == 'net5.0'"
                      allowedVersions="(,3.0.0)">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" NoWarn="NU1701"
                      Condition="$(TargetFramework.StartsWith('net4')) Or '$(TargetFramework)' == 'net6.0' Or '$(TargetFramework)' == 'net7.0'"
                      allowedVersions="(,3.0.0)">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.1"
                      Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net9.0' Or '$(TargetFramework)' == 'net10.0'">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Verify snapshot/approval testing (XmlSnapshotTests, #132), net10.0 only: the XML
       output is TFM-independent so one snapshot suffices, and Verify's transitive deps
       (Argon, DiffEngine) are not compatible with the older TFMs in this matrix. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Verify.Xunit" Version="31.12.5" />
  </ItemGroup>

  <!-- CsCheck property/fuzz testing (XmlFuzzTests, #120), net8.0+ only (CsCheck
       targets net8.0). fuzz.yaml scales the case count via the CsCheck_Time /
       CsCheck_Iter environment variables CsCheck reads at runtime. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0' OR '$(TargetFramework)' == 'net9.0' OR '$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="CsCheck" Version="4.7.0" />
  </ItemGroup>

  <!-- Analyzer PackageReferences are centralized in Directory.Build.props -->


</Project>