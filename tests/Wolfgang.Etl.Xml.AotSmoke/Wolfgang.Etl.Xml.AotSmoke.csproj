<Project Sdk="Microsoft.NET.Sdk">

  <!-- AOT / trim smoke consumer (#135). Deliberately OUT of ETL-Xml.slnx: it is
       net10.0 Native-AOT only and is published+run solely by aot.yaml on Linux,
       so it must not join the multi-TFM solution build (which also runs on
       Windows, where the AOT toolchain is unavailable). -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- The library propagates XmlSerializer's [RequiresUnreferencedCode] / [RequiresDynamicCode] to its
         public entry points and keeps the record's public members with [DynamicallyAccessedMembers] (#293).
         Program.cs suppresses the two warnings at its one call site with a justification, so the publish is
         warning-free and Release's TreatWarningsAsErrors (Directory.Build.props) fails it on any new IL
         warning. TrimmerSingleWarn=false reports each call site rather than one warning per assembly. -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Wolfgang.Etl.Xml\Wolfgang.Etl.Xml.csproj" />
  </ItemGroup>

</Project>
