<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <!-- Server GC + concurrent tuning — matches a typical long-running ETL
         workload the library would run under. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>

    <!-- CA2007: this is an .exe workload, not library code — the
         ConfigureAwait(false) discipline aimed at avoiding deadlocks in
         sync-over-async callers doesn't apply.
         The rest silence top-level-Program / single-file-workload noise. -->
    <NoWarn>$(NoWarn);CA2007;CA1050;MA0004;MA0048;S3903;VSTHRD200</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Wolfgang.Etl.Xml\Wolfgang.Etl.Xml.csproj" />
  </ItemGroup>

</Project>
